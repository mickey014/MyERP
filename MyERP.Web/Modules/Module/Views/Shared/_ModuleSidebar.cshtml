@model MyERP.Web.Modules.Module.ViewModels.ModuleSidebarViewModel

<aside class="module-shell__sidebar">

    <div class="module-shell__sidebar-header">
        <span class="module-shell__sidebar-icon">
            <i class="@Model.ModuleIcon" aria-hidden="true"></i>
        </span>

        <span class="module-shell__sidebar-title">
            @Model.ModuleTitle
        </span>
    </div>

    @{
        var currentPath = Context.Request.Path.Value ?? string.Empty;
    }

    <nav class="module-shell__nav">

        @foreach (var item in Model.Items)
        {
            // Dashboard/root links require an exact match.
            var isModuleRoot = item.Url is "/POS" or "/CRM";

            var isActive = isModuleRoot
                ? currentPath.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
                : currentPath.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase);

            <a href="@item.Url"
               class="module-shell__nav-link @(isActive ? "is-active" : "")">

                <i class="@item.Icon" aria-hidden="true"></i>

                <span>@item.Label</span>

            </a>
        }

    </nav>

    <a href="/Modules" class="module-shell__back">
        <i class="fa fa-arrow-left" aria-hidden="true"></i>
        <span>All modules</span>
    </a>

</aside>