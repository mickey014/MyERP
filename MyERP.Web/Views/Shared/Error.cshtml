@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid px-4 erp-error-page">
    <div class="erp-error-page__card">
        <i class="fa-solid fa-triangle-exclamation erp-error-page__icon" aria-hidden="true"></i>
        <h1>Something went wrong</h1>
        <p>The page couldn't be loaded. Try again, or head back to your modules.</p>
        <a class="module-card__btn" asp-controller="Modules" asp-action="Index">
            Back to Modules <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</div>
